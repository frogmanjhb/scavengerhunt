# PostgreSQL (local or Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Supabase Storage (server-side only — never expose SERVICE_ROLE_KEY to the client)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET="hunt-photos"

# Admin passcode for /admin
ADMIN_PASSCODE="change-me"

# Server
PORT=3000
NODE_ENV=development

# Optional: CORS origin in development (Vite default)
CLIENT_ORIGIN="http://localhost:5173"
